# Public base URL of this app. Must be the HTTPS URL you register with each
# platform's webhook settings (use an ngrok/tunnel URL for local development).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and keys from Supabase → Project Settings → API.
# The service role key bypasses RLS — server-side only, never expose it.
# If either the URL or the service role key is missing, the app runs on seeded
# demo data instead of Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App secrets
# ---------------------------------------------------------------------------
# Encrypts channels.access_token_encrypted (AES-256-GCM).
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=
# Reserved for the auth/session layer (not yet implemented).
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Meta — optional deployment-wide fallback
# ---------------------------------------------------------------------------
# Each workspace enters its own Meta app at /admin/credentials, so one
# deployment can serve tenants that each bring their own Meta developer app.
# Nothing below is required.
#
# Set them only if you want a house app that workspaces fall back to when they
# have not saved their own — a single-tenant install, or a hosted service that
# supplies the app for its customers. A workspace's own values always win.
META_APP_ID=
META_APP_SECRET=
# Any string you choose. Paste the same value into Meta's webhook dialog.
META_VERIFY_TOKEN=
# Only for "Instagram API with Instagram Login". That product signs its webhooks
# with its own Instagram app secret (Instagram > API setup in the dashboard),
# which differs from META_APP_SECRET.
INSTAGRAM_APP_SECRET=
# A separate verify token for the WhatsApp webhook.
# Falls back to META_VERIFY_TOKEN when unset.
WHATSAPP_VERIFY_TOKEN=
# Keep in sync with the version your Meta app targets. Deployment-wide.
META_GRAPH_API_VERSION=v26.0

# ---------------------------------------------------------------------------
# Per-channel credentials live in the database, not here
# ---------------------------------------------------------------------------
# Access tokens (Meta Pages, WhatsApp numbers, LINE bots, Telegram bots) and
# webhook secrets are stored encrypted on each channel row, entered when the
# channel is connected at /admin/channels. Meta app credentials are stored the
# same way, per organization, at /admin/credentials.
#
# LINE_CHANNEL_SECRET remains readable as a single-account fallback for
# deployments whose LINE channel predates per-channel secrets.
LINE_CHANNEL_SECRET=
