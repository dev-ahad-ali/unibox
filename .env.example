# Public base URL of this app. Must be the HTTPS URL you register with each
# platform's webhook settings (use an ngrok/tunnel URL for local development).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and keys from Supabase → Project Settings → API.
# The service role key bypasses RLS — server-side only, never expose it.
# If either the URL or the service role key is missing, the app runs on seeded
# demo data instead of Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App secrets
# ---------------------------------------------------------------------------
# Encrypts channels.access_token_encrypted (AES-256-GCM).
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=
# Reserved for the auth/session layer (not yet implemented).
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Meta — Messenger, Instagram, and WhatsApp Cloud API
# ---------------------------------------------------------------------------
# One Meta app covers all three products; the app secret signs every webhook.
META_APP_ID=
META_APP_SECRET=
# Any string you choose. Paste the same value into the webhook setup dialog for
# Messenger and Instagram in the Meta App dashboard.
META_VERIFY_TOKEN=
# Page access token for the connected Facebook Page. Used as a fallback when a
# channel row has no encrypted token of its own.
META_PAGE_ACCESS_TOKEN=
# Optional: a separate token for the Instagram account. Falls back to
# META_PAGE_ACCESS_TOKEN when unset.
INSTAGRAM_PAGE_ACCESS_TOKEN=

# WhatsApp Cloud API (WhatsApp → API Setup in the Meta App dashboard).
WHATSAPP_ACCESS_TOKEN=
# The "Phone number ID", not the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=
# Optional: a separate verify token for the WhatsApp webhook.
# Falls back to META_VERIFY_TOKEN when unset.
WHATSAPP_VERIFY_TOKEN=
# Keep in sync with the version your Meta app targets.
META_GRAPH_API_VERSION=v26.0

# ---------------------------------------------------------------------------
# LINE Messaging API
# ---------------------------------------------------------------------------
# From the LINE Developers console → your channel → Messaging API tab.
LINE_CHANNEL_ACCESS_TOKEN=
# Basic settings tab. Signs the X-Line-Signature header on every webhook.
LINE_CHANNEL_SECRET=
